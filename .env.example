# Copy this file to .env and paste your key there.
# .env is gitignored. Do not commit it. Do not paste the key into chat.
#
# This is Groq (https://console.groq.com/keys), not xAI Grok.

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Leave this as pack so `python scripts/gate.py` stays offline and deterministic.
# Set it to groq only when you want live classification.
MODEL_BACKEND=pack
